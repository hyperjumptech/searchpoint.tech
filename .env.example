BACKEND_BASE_URL=https://api.searchpoint.hyperjump.tech
UPDATER_BASE_URL=https://nss-mr1-searchpoint.nos.wjv-1.neo.id
APP_NAME=SearchPoint
# Local/dev only. Ignored when NODE_ENV=production. Must not be set in the web container.
# Truthy values: true, True, 1.
BYPASS_LOGIN=true
ENABLE_MAGIC_LINK=false
ENABLE_MICROSOFT_LOGIN=true

# Curation AI model manifest (served by /api/curation/model/manifest).
# gguf_url is resolved from UPDATER_BASE_URL above. No separate tokenizer
# file is needed — it is embedded in the GGUF.
CURATION_MODEL_FILENAME=Qwen3-0.6B-Q8_0.gguf
CURATION_MODEL_GGUF_SHA256=9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031
CURATION_MODEL_SIZE_BYTES=639446688

# Optional. Requests per minute per IP (defaults: updater 60, manifest 30).
# UPDATER_RATE_LIMIT=60
# MANIFEST_RATE_LIMIT=30

# Optional. When set, public updater/manifest rate limits are shared in Valkey
# (Redis protocol) on a fixed 60s window. Unset = in-memory sliding window.
# VALKEY_URL=redis://valkey:6379

# --- OAuth / MCP ---
# OAUTH_ISSUER=https://<public-url-of-this-app>                 # must be reachable by browser + Open WebUI server
# OAUTH_REGISTERED_CLIENTS=StartGPT|sp_abc123|http://localhost:8080/oauth/clients/mcp:searchpoint/callback
# OAUTH_SCOPES=openid profile email search magic
#  (loopback http://localhost:*/callback allows any port per RFC 8252 — useful for native apps like oh-my-pi with random ports)
# BACKEND_BASE_URL=https://api.searchpoint.hyperjump.tech             # or http://host.docker.internal:8080 for a local backend
# OAUTH_CLIENT_LABEL=Open WebUI (StartGPT SMDV)                       # shown on the consent screen
# OAUTH_CONSENT_ALWAYS=false                                          # true = show consent screen on every interactive flow (dev/testing only)
