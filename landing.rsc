otate(140 100 100)"></ellipse><ellipse cx="100" cy="100" rx="70" ry="22" transform="rotate(150 100 100)"></ellipse><ellipse cx="100" cy="100" rx="70" ry="22" transform="rotate(160 100 100)"></ellipse><ellipse cx="100" cy="100" rx="70" ry="22" transform="rotate(170 100 100)"></ellipse></g><circle cx="100" cy="100" r="92"></circle><circle cx="100" cy="100" r="30"></circle></svg><h2 class="max-w-[760px] font-display text-[32px] leading-[1.25] font-light text-balance text-black/60 dark:text-white/80 md:text-[42px] md:leading-[1.25]"><span class="text-black dark:text-white">Built for the enterprise.</span><br/>From deployment to compliance,<br/>every layer meets your audit bar.</h2><ul class="mt-16 border-b border-black/10 dark:border-white/10 md:mt-24"><li class="border-t border-black/10 dark:border-white/10"><button type="button" aria-expanded="false" class="flex w-full cursor-pointer flex-col gap-3 py-7 text-left outline-none transition-colors duration-500 md:-mx-20 md:w-[calc(100%+10rem)] md:flex-row md:items-center md:justify-between md:gap-10 md:px-20 md:py-9"><h3 class="text-[20px] leading-[1.35] font-light transition-colors duration-300 md:text-2xl text-black dark:text-white"><span aria-hidden="true" class="mr-0 inline-block h-px bg-current align-middle transition-all duration-500 ease-out w-0"></span>Flexible deployment</h3><div class="flex w-full flex-col md:w-auto md:shrink-0 md:flex-row md:items-center"><div class="order-2 grid transition-[grid-template-rows] duration-500 ease-out md:order-1 md:w-[340px] grid-rows-[0fr]"><div class="overflow-hidden"><div aria-hidden="true" class="max-w-[300px] pt-5 transition-opacity md:max-w-none duration-500 ease-out md:pt-0 md:pr-10 opacity-0"><div class="relative overflow-hidden rounded bg-[#0d0d0d] p-5 [filter:invert(1)_hue-rotate(180deg)]"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:5px_5px] [mask-image:radial-gradient(ellipse_80%_70%_at_30%_40%,black,transparent)]"></div><div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 size-48 rounded-full bg-white/[0.06] blur-2xl"></div><div class="relative"><div class="flex flex-col gap-2 py-1"><p class="text-[11px] leading-[1.4] font-light text-white/40">Deploy SearchPoint to</p><div class="relative flex items-center gap-3 rounded-[10px] px-3 py-2.5"><span class="absolute inset-0 rounded-[10px] border border-white/15 bg-white/[0.06]"></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud relative size-4 transition-colors duration-300 text-white" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg><span class="relative flex flex-1 flex-col"><span class="text-[11px] leading-[1.4] transition-colors duration-300 text-white">Your cloud</span><span class="text-[11px] leading-[1.4] font-light text-white/35">Inside your VPC</span></span><span class="relative flex size-3.5 items-center justify-center rounded-full border transition-colors duration-300 border-white"><span class="size-1.5 rounded-full bg-white transition-transform duration-300 scale-100"></span></span></div><div class="relative flex items-center gap-3 rounded-[10px] px-3 py-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server relative size-4 transition-colors duration-300 text-white/35" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg><span class="relative flex flex-1 flex-col"><span class="text-[11px] leading-[1.4] transition-colors duration-300 text-white/55">On-prem</span><span class="text-[11px] leading-[1.4] font-light text-white/35">Inside your data center</span></span><span class="relative flex size-3.5 items-center justify-center rounded-full border transition-colors duration-300 border-white/25"><span class="size-1.5 rounded-full bg-white transition-transform duration-300 scale-0"></span></span></div><div class="mt-1 flex items-center justify-between border-t border-white/10 pt-3 text-[11px] leading-[1.4] font-light"><span class="text-white/55">Records outside your environment</span><span class="font-display text-[20px] leading-[1.35] text-white tabular-nums">0</span></div></div></div></div></div></div></div><p class="order-1 text-[13px] leading-[1.5] font-light transition-colors duration-300 md:order-2 md:w-[320px] text-black/50 dark:text-white/50">Runs in your cloud or fully on-prem. Your records never leave your environment.</p></div></button></li><li class="border-t border-black/10 dark:border-white/10"><button type="button" aria-expanded="false" class="flex w-full cursor-pointer flex-col gap-3 py-7 text-left outline-none transition-colors duration-500 md:-mx-20 md:w-[calc(100%+10rem)] md:flex-row md:items-center md:justify-between md:gap-10 md:px-20 md:py-9"><h3 class="text-[20px] leading-[1.35] font-light transition-colors duration-300 md:text-2xl text-black dark:text-white"><span aria-hidden="true" class="mr-0 inline-block h-px bg-current align-middle transition-all duration-500 ease-out w-0"></span>Permission-aware</h3><div class="flex w-full flex-col md:w-auto md:shrink-0 md:flex-row md:items-center"><div class="order-2 grid transition-[grid-template-rows] duration-500 ease-out md:order-1 md:w-[340px] grid-rows-[0fr]"><div class="overflow-hidden"><div aria-hidden="true" class="max-w-[300px] pt-5 transition-opacity md:max-w-none duration-500 ease-out md:pt-0 md:pr-10 opacity-0"><div class="relative overflow-hidden rounded bg-[#0d0d0d] p-5 [filter:invert(1)_hue-rotate(180deg)]"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:5px_5px] [mask-image:radial-gradient(ellipse_80%_70%_at_30%_40%,black,transparent)]"></div><div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 size-48 rounded-full bg-white/[0.06] blur-2xl"></div><div class="relative"><div class="flex flex-col gap-3 py-1"><p class="text-[11px] leading-[1.4] font-light text-white/45">“What was Q3 gross margin?”</p><div class="flex items-center gap-3 border-t border-white/10 pt-3"><span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-white/15 text-[11px] leading-[1.4] font-light text-white/70">VT</span><span class="flex-1 text-[11px] leading-[1.4] font-light text-white/55">Head of Finance</span><span class="flex items-center gap-2"><span class="font-display text-[20px] leading-[1.35] font-light text-white tabular-nums transition-[filter,opacity] duration-700 ease-out" style="filter:blur(0px);opacity:1;transition-delay:0ms">18,4%</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3.5 text-white/70" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></div><div class="flex items-center gap-3 border-t border-white/10 pt-3"><span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-white/15 text-[11px] leading-[1.4] font-light text-white/70">RP</span><span class="flex-1 text-[11px] leading-[1.4] font-light text-white/55">Sales staff</span><span class="flex items-center gap-2"><span class="font-display text-[20px] leading-[1.35] font-light text-white tabular-nums transition-[filter,opacity] duration-700 ease-out" style="filter:blur(0px);opacity:1;transition-delay:0ms">18,4%</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock size-3.5 text-white/50" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span></div></div></div></div></div></div></div><p class="order-1 text-[13px] leading-[1.5] font-light transition-colors duration-300 md:order-2 md:w-[320px] text-black/50 dark:text-white/50">Agents inherit the roles people already have. Every answer stays inside what that person may see.</p></div></button></li><li class="border-t border-black/10 dark:border-white/10"><button type="button" aria-expanded="false" class="flex w-full cursor-pointer flex-col gap-3 py-7 text-left outline-none transition-colors duration-500 md:-mx-20 md:w-[calc(100%+10rem)] md:flex-row md:items-center md:justify-between md:gap-10 md:px-20 md:py-9"><h3 class="text-[20px] leading-[1.35] font-light transition-colors duration-300 md:text-2xl text-black dark:text-white"><span aria-hidden="true" class="mr-0 inline-block h-px bg-current align-middle transition-all duration-500 ease-out w-0"></span>Data protection</h3><div class="flex w-full flex-col md:w-auto md:shrink-0 md:flex-row md:items-center"><div class="order-2 grid transition-[grid-template-rows] duration-500 ease-out md:order-1 md:w-[340px] grid-rows-[0fr]"><div class="overflow-hidden"><div aria-hidden="true" class="max-w-[300px] pt-5 transition-opacity md:max-w-none duration-500 ease-out md:pt-0 md:pr-10 opacity-0"><div class="relative overflow-hidden rounded bg-[#0d0d0d] p-5 [filter:invert(1)_hue-rotate(180deg)]"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:5px_5px] [mask-image:radial-gradient(ellipse_80%_70%_at_30%_40%,black,transparent)]"></div><div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 size-48 rounded-full bg-white/[0.06] blur-2xl"></div><div class="relative"><div class="flex flex-col gap-3 py-1"><div class="flex flex-col gap-1.5 font-mono text-[11px] leading-[1.4] tracking-wide text-white/70 tabular-nums"><span class="whitespace-pre">PT Sinar Jaya</span><span class="whitespace-pre">Invoice 0417</span><span class="whitespace-pre">Rp 184.000.000</span></div><div class="flex items-center justify-between border-t border-white/10 pt-3 text-[11px] leading-[1.4] font-light"><span class="flex items-center gap-1.5 text-white/55"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock size-3" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> <!-- -->In transit · at rest</span><span class="text-white">Encrypted</span></div><div class="flex items-center justify-between text-[11px] leading-[1.4] font-light"><span class="text-white/55">Sent to train public models</span><span class="font-display text-[20px] leading-[1.35] text-white tabular-nums">0</span></div></div></div></div></div></div></div><p class="order-1 text-[13px] leading-[1.5] font-light transition-colors duration-300 md:order-2 md:w-[320px] text-black/50 dark:text-white/50">Your data never trains public models. Encrypted in transit and at rest, any model you choose.</p></div></button></li><li class="border-t border-black/10 dark:border-white/10"><button type="button" aria-expanded="false" class="flex w-full cursor-pointer flex-col gap-3 py-7 text-left outline-none transition-colors duration-500 md:-mx-20 md:w-[calc(100%+10rem)] md:flex-row md:items-center md:justify-between md:gap-10 md:px-20 md:py-9"><h3 class="text-[20px] leading-[1.35] font-light transition-colors duration-300 md:text-2xl text-black dark:text-white"><span aria-hidden="true" class="mr-0 inline-block h-px bg-current align-middle transition-all duration-500 ease-out w-0"></span>Compliance &amp; standards</h3><div class="flex w-full flex-col md:w-auto md:shrink-0 md:flex-row md:items-center"><div class="order-2 grid transition-[grid-template-rows] duration-500 ease-out md:order-1 md:w-[340px] grid-rows-[0fr]"><div class="overflow-hidden"><div aria-hidden="true" class="max-w-[300px] pt-5 transition-opacity md:max-w-none duration-500 ease-out md:pt-0 md:pr-10 opacity-0"><div class="relative overflow-hidden rounded bg-[#0d0d0d] p-5 [filter:invert(1)_hue-rotate(180deg)]"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:5px_5px] [mask-image:radial-gradient(ellipse_80%_70%_at_30%_40%,black,transparent)]"></div><div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 size-48 rounded-full bg-white/[0.06] blur-2xl"></div><div class="relative"><div class="flex items-center gap-5 py-1"><svg viewBox="0 0 120 120" class="size-28 shrink-0" fill="none"><defs><path id="nx-seal-ring" d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0"></path></defs><circle cx="60" cy="60" r="56" stroke="rgba(255,255,255,0.14)"></circle><circle cx="60" cy="60" r="33" stroke="rgba(255,255,255,0.22)"></circle><g style="transform-origin:60px 60px;animation:nx-seal-spin 18s linear infinite;animation-play-state:paused"><text fill="rgba(255,255,255,0.55)" font-size="7.6" letter-spacing="0.16em"><textPath href="#nx-seal-ring">SOC 2 · DATA RESIDENCY · ENTERPRISE PLANS · </textPath></text></g><path d="M60 44 l12 5 v9 c0 8 -5 14 -12 17 c-7 -3 -12 -9 -12 -17 v-9 z" stroke="white" stroke-width="1.1"></path><path d="M55 59 l4 4 l7 -8" stroke="white" stroke-width="1.1"></path></svg><div class="flex flex-col gap-2 text-[11px] leading-[1.4] font-light"><span class="text-white">SOC 2</span><span class="text-white">Data residency</span><span class="text-white/45">On enterprise plans</span></div></div></div></div></div></div></div><p class="order-1 text-[13px] leading-[1.5] font-light transition-colors duration-300 md:order-2 md:w-[320px] text-black/50 dark:text-white/50">SOC 2 compliance and dedicated data residency on enterprise plans, with access controls you define.</p></div></button></li></ul></div><style>@keyframes nx-seal-spin { to { transform: rotate(360deg); } }</style></section><section id="faq" class="scroll-mt-24 border-t border-border/40 py-16 md:py-20"><div class="sp-container"><div class="mb-12"><h2 class="section-title font-display font-light text-foreground text-3xl md:text-5xl tracking-tight leading-[1.1] max-w-[580px] mt-3">Client FAQ &amp; Product Architecture.</h2><p class="mt-3 text-sm text-muted-foreground font-light max-w-[520px] leading-relaxed">Answers to common enterprise security and deployment questions, grounded in shipped product behavior.</p></div><ul class="faq-list"><li data-idx="0" class="faq-item" style="--reveal-delay:0ms"><button type="button" id="sp-faq-q-0" aria-expanded="false" aria-controls="sp-faq-panel-0" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">Do you store copies or binary contents of our company files?</span></button><div id="sp-faq-panel-0" role="region" aria-labelledby="sp-faq-q-0" class="faq-answer"><div class="faq-answer-inner"><p>No. SearchPoint is an indexing and retrieval engine, NOT a document repository. We never store copies or binaries of your files. During indexing, content is parsed temporarily in an isolated, short-lived native sandbox and immediately purged from memory. SearchPoint only retains metadata, keywords, and text summaries in your private hybrid search cluster.</p></div></div></li><li data-idx="1" class="faq-item" style="--reveal-delay:55ms"><button type="button" id="sp-faq-q-1" aria-expanded="false" aria-controls="sp-faq-panel-1" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">How does SearchPoint enforce permissions and prevent accidental oversharing?</span></button><div id="sp-faq-panel-1" role="region" aria-labelledby="sp-faq-q-1" class="faq-answer"><div class="faq-answer-inner"><p>This is our core architectural differentiator: document-level purview enforced per query, mirroring your real Microsoft 365, SharePoint, and filesystem permissions. If an employee cannot open a document in OneDrive or Windows, they will not see it in SearchPoint or AI context. Authorization is strictly fail-closed — if a snapshot is missing, access is denied.</p></div></div></li><li data-idx="2" class="faq-item" style="--reveal-delay:110ms"><button type="button" id="sp-faq-q-2" aria-expanded="false" aria-controls="sp-faq-panel-2" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">What happens when a document is deleted, moved, or locked down at the source?</span></button><div id="sp-faq-panel-2" role="region" aria-labelledby="sp-faq-q-2" class="faq-answer"><div class="faq-answer-inner"><p>Truth-mirroring deletes are instantaneous. Through Microsoft Graph delta queries and real-time reconciliation backstops, whenever a file is deleted, moved, or restricted at the source, it disappears immediately from SearchPoint. No ghost copies haunt search results or AI pipelines.</p></div></div></li><li data-idx="3" class="faq-item" style="--reveal-delay:165ms"><button type="button" id="sp-faq-q-3" aria-expanded="false" aria-controls="sp-faq-panel-3" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">Do we need to migrate our files or re-upload them to your cloud?</span></button><div id="sp-faq-panel-3" role="region" aria-labelledby="sp-faq-q-3" class="faq-answer"><div class="faq-answer-inner"><p>Zero migration and zero re-upload. SearchPoint connects directly to your existing Microsoft Entra ID (Azure AD), OneDrive, SharePoint sites, and local desktop directories. Your data stays exactly where it lives today.</p></div></div></li><li data-idx="4" class="faq-item" style="--reveal-delay:220ms"><button type="button" id="sp-faq-q-4" aria-expanded="false" aria-controls="sp-faq-panel-4" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">Can SearchPoint be deployed fully on-premise or in our private tenant?</span></button><div id="sp-faq-panel-4" role="region" aria-labelledby="sp-faq-q-4" class="faq-answer"><div class="faq-answer-inner"><p>Yes. The entire stack runs self-hosted on your own VMs and private network. No document content ever leaves your tenant into a third-party SaaS. All credentials and encryption keys are stored and rotated in HashiCorp Vault with KMS auto-unseal (AWS/Azure/GCP) and mTLS certificate revocation checking.</p></div></div></li><li data-idx="5" class="faq-item" style="--reveal-delay:275ms"><button type="button" id="sp-faq-q-5" aria-expanded="false" aria-controls="sp-faq-panel-5" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">How does the on-device AI Intelligent Rename feature work?</span></button><div id="sp-faq-panel-5" role="region" aria-labelledby="sp-faq-q-5" class="faq-answer"><div class="faq-answer-inner"><p>SearchPoint uses a lightweight on-device neural model that inspects the structure and first few pages of chaotic downloads (e.g. `download(3).pdf` or raw scanner files). It automatically suggests clean, standardized naming conventions (such as `Category - Entity - Year - Title.pdf`) without sending file content over the internet.</p></div></div></li><li data-idx="6" class="faq-item" style="--reveal-delay:330ms"><button type="button" id="sp-faq-q-6" aria-expanded="false" aria-controls="sp-faq-panel-6" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">Which search operators and languages are supported?</span></button><div id="sp-faq-panel-6" role="region" aria-labelledby="sp-faq-q-6" class="faq-answer"><div class="faq-answer-inner"><p>SearchPoint supports boolean logic operators (AND, OR, NOT), exact phrase matching, field boosting (`source:on_device`, `type:pdf`), fuzzy tolerance for typos, and full multilingual stemming for English and Bahasa Indonesia.</p></div></div></li><li data-idx="7" class="faq-item" style="--reveal-delay:385ms"><button type="button" id="sp-faq-q-7" aria-expanded="false" aria-controls="sp-faq-panel-7" class="faq-question"><span class="faq-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="faq-question-text">How does SearchPoint ground LLMs (like ChatGPT, Claude, or Ollama)?</span></button><div id="sp-faq-panel-7" role="region" aria-labelledby="sp-faq-q-7" class="faq-answer"><div class="faq-answer-inner"><p>SearchPoint provides a structured, context-rich retrieval pipeline (RAG). When you query your AI, SearchPoint fetches only verified, permission-permitted document snippets with verbatim source citations. This eliminates hallucinations while ensuring confidential executive documents are never leaked into employee AI prompts.</p></div></div></li></ul></div></section><section id="download" class="text-center border-t border-border/40 scroll-mt-20"><div class="dl-orbit" aria-hidden="true"><div class="dl-ring dl-ring--outer" data-dir="rev"><span class="dl-node" style="--a:0deg;--r:380px"><span class="dl-tile" style="--accent:#34d399"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers w-[22px] h-[22px]" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span></span><span class="dl-node" style="--a:60deg;--r:380px"><span class="dl-tile" style="--accent:#f87171"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail w-[22px] h-[22px]" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg></span></span><span class="dl-node" style="--a:120deg;--r:380px"><span class="dl-tile" style="--accent:#fbbf24"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-box w-[22px] h-[22px]" aria-hidden="true"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg></span></span><span class="dl-node" style="--a:180deg;--r:380px"><span class="dl-tile" style="--accent:#f59e0b"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock w-[22px] h-[22px]" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span></span><span class="dl-node" style="--a:240deg;--r:380px"><span class="dl-tile" style="--accent:#22d3ee"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal w-[22px] h-[22px]" aria-hidden="true"><path d="M12 19h8"></path><path d="m4 17 6-6-6-6"></path></svg></span></span><span class="dl-node" style="--a:300deg;--r:380px"><span class="dl-tile" style="--accent:#8b5cf6"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-[22px] h-[22px]" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></span></span></div><div class="dl-ring dl-ring--mid" data-dir="fwd"><span class="dl-node" style="--a:0deg;--r:270px"><span class="dl-tile" style="--accent:#60a5fa"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud w-[22px] h-[22px]" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></span></span><span class="dl-node" style="--a:90deg;--r:270px"><span class="dl-tile" style="--accent:#38bdf8"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail w-[22px] h-[22px]" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg></span></span><span class="dl-node" style="--a:180deg;--r:270px"><span class="dl-tile" style="--accent:#a78bfa"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-[22px] h-[22px]" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></span></span><span class="dl-node" style="--a:270deg;--r:270px"><span class="dl-tile" style="--accent:#c084fc"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open w-[22px] h-[22px]" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span></span></div><div class="dl-ring dl-ring--inner" data-dir="rev"><span class="dl-node" style="--a:0deg;--r:160px"><span class="dl-tile" style="--accent:#fbbf24"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text w-[22px] h-[22px]" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></span></span><span class="dl-node" style="--a:180deg;--r:160px"><span class="dl-tile" style="--accent:#4ade80"><svg xmlns="http://www.w3.