50/80 px-[9px] text-[10.5px] leading-none font-light whitespace-nowrap text-slate-700 shadow-sm dark:border-white/12 dark:bg-[#111112] dark:text-white/80"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-[13px]"><path d="M8.2 3L1.5 14.7L5 20.8L11.7 9.1L8.2 3Z" fill="#0066DA"></path><path d="M15.8 3H8.2L11.7 9.1H19.3L15.8 3Z" fill="#00AC47"></path><path d="M19.3 9.1H11.7L15.2 15.2H22.7L19.3 9.1Z" fill="#EA4335"></path><path d="M15.2 15.2L11.7 21.2H19.3L22.7 15.2H15.2Z" fill="#FFBA00"></path></svg>Google Drive</span><div aria-hidden="true" class="nx-hiwd-dash h-px min-w-[10px] flex-1" style="background:repeating-linear-gradient(90deg, rgba(255,255,255,0.3) 0 4px, transparent 4px 9px)"></div></div><div class="flex items-center"><span class="flex h-[26px] items-center gap-[6px] rounded-[10px] border border-slate-200/80 bg-slate-50/80 px-[9px] text-[10.5px] leading-none font-light whitespace-nowrap text-slate-700 shadow-sm dark:border-white/12 dark:bg-[#111112] dark:text-white/80"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-[13px]"><rect x="7" y="5" width="15" height="14" rx="2" fill="#0078D4"></rect><path d="M7 6.5L14.5 12L22 6.5" stroke="white" stroke-width="1.2"></path><rect x="2" y="7" width="9" height="10" rx="1.5" fill="#106EBE"></rect><text x="4.2" y="14.5" fill="white" font-family="Arial, Helvetica, sans-serif" font-weight="bold" font-size="7.5">O</text></svg>Outlook</span><div aria-hidden="true" class="nx-hiwd-dash h-px min-w-[10px] flex-1" style="background:repeating-linear-gradient(90deg, rgba(255,255,255,0.3) 0 4px, transparent 4px 9px)"></div></div><div class="flex items-center"><span class="flex h-[26px] items-center gap-[6px] rounded-[10px] border border-slate-200/80 bg-slate-50/80 px-[9px] text-[10.5px] leading-none font-light whitespace-nowrap text-slate-700 shadow-sm dark:border-white/12 dark:bg-[#111112] dark:text-white/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-[13px] text-slate-400 dark:text-white/50" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>10+Sources</span><div aria-hidden="true" class="nx-hiwd-dash h-px min-w-[10px] flex-1" style="background:repeating-linear-gradient(90deg, rgba(255,255,255,0.3) 0 4px, transparent 4px 9px)"></div></div></div></div><div class="hidden items-center lg:flex"><div aria-hidden="true" class="nx-hiwd-dash h-px w-[24px] shrink-0" style="background:repeating-linear-gradient(90deg, rgba(255,255,255,0.3) 0 4px, transparent 4px 9px)"></div><span aria-hidden="true" class="arch-arrow-right shrink-0 border-y-[3px] border-l-[5px] border-y-transparent border-l-slate-400 dark:border-l-white/40"></span></div></div></div></div></div><div class="hidden items-center lg:flex"><div class="relative flex w-full items-center"><div aria-hidden="true" class="nx-hiwd-dash h-px w-full" style="background:repeating-linear-gradient(90deg, rgba(255,255,255,0.3) 0 4px, transparent 4px 9px)"></div><span aria-hidden="true" class="arch-arrow-right absolute right-0 border-y-[3px] border-l-[5px] border-y-transparent border-l-slate-400 dark:border-l-white/40"></span></div></div><div class="flex items-center justify-center gap-[16px] lg:hidden my-1"><span class="flex flex-col items-center"><div aria-hidden="true" class="arch-dash-v w-px" style="height:36px;background:repeating-linear-gradient(180deg, rgba(255,255,255,0.25) 0 3px, transparent 3px 7px)"></div><span aria-hidden="true" class="arch-arrow-down border-x-[3px] border-t-[5px] border-x-transparent border-t-slate-400 dark:border-t-white/40"></span></span></div><div class="flex flex-col"><div class="arch-flame-card relative flex min-h-[340px] flex-1 flex-col justify-center overflow-hidden rounded-[14px] border border-orange-500/20 bg-[#121212] p-5 sm:p-[28px] dark:border-white/12"><di