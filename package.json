    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "playwright": "^1.56.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^6.2.1",
