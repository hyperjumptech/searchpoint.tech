{
  "name": "scse-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
